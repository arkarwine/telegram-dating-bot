[Unit]
Description=Telegram Dating Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=telegrambot
Group=telegrambot
WorkingDirectory=/opt/telegram-dating-bot
EnvironmentFile=/opt/telegram-dating-bot/.env
ExecStart=/opt/telegram-dating-bot/.venv/bin/python -m bot.main
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target

